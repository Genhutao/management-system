<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.XghApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_surface</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowBackground">@color/brand_surface</item>
    </style>

    <!-- 宿管大字版文本样式 -->
    <style name="TextTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextBig">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_main</item>
    </style>
    <style name="TextSub">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_sub</item>
    </style>
    <style name="InputBig">
        <item name="android:textSize">20sp</item>
        <item name="android:padding">14dp</item>
    </style>
</resources>
